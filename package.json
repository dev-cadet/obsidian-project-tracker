{
  "name": "project-tracker",
  "version": "1.0.1",
  "description": "GitHub Projects-style boards for Obsidian",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "esbuild tests/logic.test.ts --bundle --platform=node --format=cjs --outfile=tests/.bundle.cjs --log-level=warning && node tests/.bundle.cjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.7.2",
    "sass": "^1.103.1",
    "typescript": "^5.7.2"
  }
}
